{
  "name": "ecommerce-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "migration:run": "node --require ts-node/register ./node_modules/typeorm/cli.js -d src/data-source.ts migration:run",
    "migration:revert": "node --require ts-node/register ./node_modules/typeorm/cli.js -d src/data-source.ts migration:revert",
    "seed:admin": "node --require ts-node/register src/scripts/seed-admin.ts"
  },
  "dependencies": {
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "latest",
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/graphql": "latest",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "latest",
    "@nestjs/typeorm": "latest",
    "bcryptjs": "^3.0.3",
    "class-transformer": "latest",
    "class-validator": "latest",
    "graphql": "latest",
    "pg": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "typeorm": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@nestjs/schematics": "latest",
    "@nestjs/testing": "latest",
    "@types/express": "latest",
    "@types/jest": "latest",
    "@types/node": "^20",
    "eslint": "latest",
    "jest": "latest",
    "prettier": "latest",
    "ts-jest": "latest",
    "ts-loader": "latest",
    "ts-node": "latest",
    "typescript": "^5"
  }
}
